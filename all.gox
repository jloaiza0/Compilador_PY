/* Programa integrado que muestra diversas características de GoX */

// Constantes y variables básicas
const PI = 3.1415;
const newline = '\n';
const LAST = 20;

var x int = 5;
var y int = 3;
var z float = 2.5;

// Operaciones matemáticas
var result int = (x + y) * z;
var final float = result / 2.0;

// Funciones matemáticas útiles
func mod(x int, y int) int {
    return x - (x/y) * y;
}

func isprime(n int) bool {
    if n < 2 {
        return false;
    }
    var i int = 2;
    while i * i <= n {
        if mod(n, i) == 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Función de factorización
func factorize(n int) int {
    var factor int = 2;
    while n > 1 {
        while mod(n, factor) == 0 {
            print factor;
            n = n / factor;
        }
        factor = factor + 1;
    }
    return 0;
}

// Función Fibonacci recursiva
func fib(n int) int {
    if n <= 1 {
        return 1;
    }
    return fib(n-1) + fib(n-2);
}

// Prueba de break/continue
var n int = 0;
while true {
    n = n + 1;
    if n == 5 {
        continue;
    }
    print n;
    if n > 10 {
        break;
    }
}
print -1;

